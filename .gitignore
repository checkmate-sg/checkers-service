!scripts/backfill-target-daily-votes.js
!scripts/upload-parameters.js
!scripts/eval-faq.js

# Per-environment threshold values stay local, but faqs.json is published copy:
# it is the only thing the group-chat bot is allowed to say, so it belongs in
# review and in history like any other user-facing string.
parameters/*
!parameters/faqs.json