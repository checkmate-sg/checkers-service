{
  "main": ".open-next/worker.js",
  "name": "checkmate-checkers-app",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-08-09",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "checkmate-checkers-app"
    },
    {
      "binding": "CHECKMATE_WHATSAPP_SERVICE",
      "service": "whatsapp-webhook-handler"
    }
  ],
  // R2 incremental cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "checkers-app-cache"
    }
  ],
  // DO Queue
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "env": {
    "staging": {
      "name": "checkmate-checkers-app-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "NEXTAUTH_URL": "https://checkers.staging.checkmate.sg"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "checkmate-checkers-app-staging"
        },
        {
          "binding": "CHECKMATE_WHATSAPP_SERVICE",
          "service": "whatsapp-webhook-handler-staging"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "checkers-app-cache-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler"
          }
        ]
      },
      "observability": {
        "logs": {
          "enabled": true
        }
      }
    },
    "production": {
      "name": "checkmate-checkers-app",
      "vars": {
        "ENVIRONMENT": "production",
        "NEXTAUTH_URL": "https://checkers.checkmate.sg"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "checkmate-checkers-app"
        },
        {
          "binding": "CHECKMATE_WHATSAPP_SERVICE",
          "service": "whatsapp-webhook-handler"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "checkers-app-cache"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler"
          }
        ]
      },
      "observability": {
        "logs": {
          "enabled": true
        }
      }
    }
  }
}
